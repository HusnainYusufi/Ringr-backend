# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Set to true to bypass Twilio/Google Maps in demos — OTP accepts 123456 for any phone
DEMO_MODE=true

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── Database ──────────────────────────────────────────────────────────────────
# IMPORTANT: this file is committed. Never put real credentials here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ringr"
# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-in-production
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Retell AI ─────────────────────────────────────────────────────────────────
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxx
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret

# ─── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15005550006
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SMTP (nodemailer; Gmail by default) ──────────────────────────────────────
# For Gmail: SMTP_PASS must be a Google "App Password", not your real password.
# https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_USER=notifications@example.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=Ringr <notifications@example.com>
# Alternatively, an explicit host (e.g. SendGrid / SES) — leave blank to use SMTP_SERVICE
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=465

# ─── Google Maps (geocoding) ───────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
