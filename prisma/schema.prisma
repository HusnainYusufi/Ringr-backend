generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  PROVIDER_OWNER
  PROVIDER_STAFF
  CUSTOMER
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SubscriptionTier {
  STARTER // API + webhooks only; no portal access. Free monthly fee, per-booking after the free quota.
  PRO // API + webhooks + portal. Flat monthly fee.
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

// ─── Core Tenant / Vertical ───────────────────────────────────────────────────

model Vertical {
  id     String @id @default(cuid())
  name   String @unique
  slug   String @unique
  // JSON shape: { providerLabel, customerLabel, subjectLabel, extraFieldsSchema, greeting, systemPrompt }
  config Json

  tenants   Tenant[]
  providers Provider[]
}

model Tenant {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  subdomain  String   @unique
  apiKey     String   @unique
  verticalId String
  vertical   Vertical @relation(fields: [verticalId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  retellAgents      RetellAgent[]
  providers         Provider[]
  providerStaff     ProviderStaff[]
  schedules         ProviderSchedule[]
  slots             Slot[]
  customers         Customer[]
  subjects          Subject[]
  bookings          Booking[]
  callSessions      CallSession[]
  refreshTokens     RefreshToken[]
  magicLinks        MagicLink[]
  blackouts         ProviderBlackout[]
  providerBilling   ProviderBilling[]
  billingLedger     BillingLedgerEntry[]
  subscriptions     Subscription[]
  providerApiKeys   ProviderApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]

  @@index([apiKey])
  @@index([subdomain])
}

model RetellAgent {
  id       String @id @default(cuid())
  agentId  String @unique
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([agentId])
}

// ─── Provider ─────────────────────────────────────────────────────────────────

model Provider {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  // Service classification (vet, dental, auto, ...). The AI agent uses this to
  // filter providers based on what the caller asks for. Optional only because
  // the migration is non-destructive — new providers must always set this.
  verticalId String?
  vertical   Vertical? @relation(fields: [verticalId], references: [id])
  name       String
  address    String
  city       String
  province   String    @default("ON")
  postalCode String
  lat        Float
  lng        Float
  phone      String
  email      String
  bio        String?
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  staff            ProviderStaff[]
  schedules        ProviderSchedule[]
  slots            Slot[]
  bookings         Booking[]
  blackouts        ProviderBlackout[]
  billing          ProviderBilling?
  subscription     Subscription?
  apiKeys          ProviderApiKey[]
  webhookEndpoints WebhookEndpoint[]

  @@index([tenantId])
  @@index([tenantId, isDeleted])
  @@index([tenantId, isActive, isDeleted])
  @@index([verticalId])
}

// A date range during which the provider is unavailable (vacation, public
// holiday, equipment outage…). Used by the slot generator (skip dates inside
// a blackout) and the create-blackout flow (mark existing AVAILABLE slots
// inside the range as BLOCKED so the AI agent can't book them).
model ProviderBlackout {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  // [startsAt, endsAt) — endsAt is exclusive so a single-day blackout is
  // startsAt=2026-08-05T00:00, endsAt=2026-08-06T00:00.
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  createdAt  DateTime @default(now())

  @@index([tenantId, providerId])
  @@index([providerId, startsAt, endsAt])
}

model ProviderSchedule {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  providerId          String
  provider            Provider @relation(fields: [providerId], references: [id])
  dayOfWeek           Int // 0=Sunday … 6=Saturday
  startTime           String // "09:00"
  endTime             String // "17:00"
  slotDurationMinutes Int      @default(30)
  isActive            Boolean  @default(true)

  @@index([tenantId, providerId])
}

model ProviderStaff {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  providerId   String
  provider     Provider  @relation(fields: [providerId], references: [id])
  email        String
  passwordHash String
  firstName    String
  lastName     String
  role         Role      @default(PROVIDER_STAFF)
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens RefreshToken[]
  magicLinks    MagicLink[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, email])
}

// ─── Slots ────────────────────────────────────────────────────────────────────

model Slot {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  providerId String
  provider   Provider   @relation(fields: [providerId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  status     SlotStatus @default(AVAILABLE)
  heldBy     String? // customerId holding this slot
  heldAt     DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  booking Booking?

  @@unique([tenantId, providerId, startsAt])
  @@index([tenantId, providerId, startsAt, status])
  @@index([tenantId, status])
}

// ─── Customer / Subject ───────────────────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  phone     String
  name      String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subjects      Subject[]
  bookings      Booking[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, phone])
}

model Subject {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  name        String
  type        String // "dog", "cat", "tooth", "car", etc.
  extraFields Json      @default("{}")
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings Booking[]

  @@index([tenantId, customerId])
}

// ─── Booking ──────────────────────────────────────────────────────────────────

model Booking {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  slotId      String        @unique
  slot        Slot          @relation(fields: [slotId], references: [id])
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  providerId  String
  provider    Provider      @relation(fields: [providerId], references: [id])
  subjectId   String?
  subject     Subject?      @relation(fields: [subjectId], references: [id])
  status      BookingStatus @default(CONFIRMED)
  // Vertical-specific data (pet species, treatment type, car make, etc.)
  extraFields Json          @default("{}")
  notes       String?
  cancelledAt DateTime?
  completedAt DateTime?
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  callSession CallSession?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, providerId])
  @@index([tenantId, createdAt])
}

// ─── Voice / Call ─────────────────────────────────────────────────────────────

model CallSession {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  callId     String    @unique
  agentId    String
  fromPhone  String
  transcript String?
  summary    String?
  durationMs Int?
  bookingId  String?   @unique
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  @@index([tenantId])
  @@index([tenantId, fromPhone])
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model RefreshToken {
  id         String         @id @default(cuid())
  token      String         @unique
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  customerId String?
  customer   Customer?      @relation(fields: [customerId], references: [id])
  staffId    String?
  staff      ProviderStaff? @relation(fields: [staffId], references: [id])
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@index([token])
  @@index([tenantId])
}

// Single-use, time-bound invitation tokens emailed to onboarded provider owners
// so they can set their initial password without us shipping plaintext creds.
model MagicLink {
  id         String        @id @default(cuid())
  token      String        @unique
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  staffId    String
  staff      ProviderStaff @relation(fields: [staffId], references: [id])
  email      String
  purpose    String        @default("ONBOARDING") // ONBOARDING | PASSWORD_RESET
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([token])
  @@index([staffId])
  @@index([tenantId])
}

// ─── Billing ──────────────────────────────────────────────────────────────────
//
// One row per provider. Created automatically when a provider is onboarded.
// First `freeQuota` completed bookings are free; every completed booking after
// that accrues `chargePerBookingCents`. Charges are recorded as ledger entries
// (BillingLedgerEntry) so the SUPER_ADMIN dashboard can show a history.
//
// v1 uses a flat fee per booking. To switch to a percentage of booking value
// later, add `Booking.amountCents` and recompute the entry amount.
model ProviderBilling {
  id                    String    @id @default(cuid())
  tenantId              String
  tenant                Tenant    @relation(fields: [tenantId], references: [id])
  providerId            String    @unique
  provider              Provider  @relation(fields: [providerId], references: [id])
  freeQuota             Int       @default(20)
  freeBookingsUsed      Int       @default(0)
  paidBookingsCount     Int       @default(0)
  chargePerBookingCents Int       @default(500) // $5.00 default; tunable per provider
  totalChargedCents     Int       @default(0)
  lastChargedAt         DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  ledgerEntries BillingLedgerEntry[]

  @@index([tenantId])
}

model BillingLedgerEntry {
  id          String          @id @default(cuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  providerId  String
  billingId   String
  billing     ProviderBilling @relation(fields: [billingId], references: [id])
  // One ledger entry per booking event — unique guard against double-charge if
  // booking.completed fires twice.
  bookingId   String          @unique
  type        String // FREE | CHARGE | CREDIT | ADJUSTMENT
  amountCents Int             @default(0)
  description String?
  createdAt   DateTime        @default(now())

  @@index([tenantId, providerId])
  @@index([providerId, createdAt])
}

// ─── Subscriptions ────────────────────────────────────────────────────────────
//
// One row per provider. STARTER providers use the API + webhooks only;
// PRO providers additionally get the portal. Tier choice happens at onboarding
// and can be changed by SUPER_ADMIN.
model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String
  providerId           String             @unique
  provider             Provider           @relation(fields: [providerId], references: [id])
  tier                 SubscriptionTier   @default(STARTER)
  status               SubscriptionStatus @default(ACTIVE)
  // Stripe integration lands in Phase 6c; these are placeholders for now.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  Tenant               Tenant             @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tier])
  @@index([status])
}

// ─── Provider API keys ────────────────────────────────────────────────────────
//
// Vendors (vet PMS systems etc.) authenticate to /api/v1/integrations/* with
// these. Plaintext is only ever returned once at issuance time — we store
// SHA-256 of the secret and a last-four for display.
model ProviderApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  providerId String
  provider   Provider  @relation(fields: [providerId], references: [id])
  // Human-friendly label set at creation, e.g. "Production Vetspire integration".
  name       String
  // SHA-256 of the full secret. Lookups go through this so we never store the plaintext.
  keyHash    String    @unique
  // The prefix (first 8 chars of the secret) is safe to expose for UI display.
  keyPrefix  String
  // Last 4 chars of the plaintext for visual identification ("…a3f9").
  lastFour   String
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  Tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@index([providerId])
  @@index([tenantId])
  @@index([keyPrefix])
}

// ─── Outbound webhooks ────────────────────────────────────────────────────────
//
// Where a provider's external system listens for booking events. Phase 6b
// builds the dispatcher; this just lets us store endpoints + audit deliveries.
model WebhookEndpoint {
  id         String   @id @default(cuid())
  tenantId   String
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  url        String
  // Comma-separated event names the endpoint subscribes to.
  // e.g. "booking.confirmed,booking.cancelled,booking.completed,booking.no_show"
  events     String
  // HMAC-SHA256 secret used to sign outgoing payloads. Returned only once at
  // creation; stored encrypted-at-rest in a future hardening pass.
  secret     String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveries WebhookDelivery[]
  Tenant     Tenant            @relation(fields: [tenantId], references: [id])

  @@index([providerId])
  @@index([tenantId])
  @@index([enabled])
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  // Event name that triggered the delivery.
  event        String
  // Booking ID (or whatever the event payload's primary entity is) — for grouping
  // and dedup. Unique-combined with event + endpoint to make retries safe.
  resourceId   String
  // Full JSON payload that was sent — for replay/debug.
  payload      Json
  // Last attempt result.
  responseCode Int?
  responseBody String?
  attempts     Int             @default(0)
  // Bull job lifecycle.
  succeededAt  DateTime?
  failedAt     DateTime?
  nextRetryAt  DateTime?
  createdAt    DateTime        @default(now())

  @@unique([endpointId, event, resourceId])
  @@index([tenantId])
  @@index([endpointId, createdAt])
  @@index([nextRetryAt])
}
